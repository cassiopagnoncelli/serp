#!/usr/bin/env bash

set -e

#~ USAGE
#~
#~   serp new NAME
#~
#~
#~ COMMANDS
#~
#~   --help  - View these usage instructions
#~

log() {
  echo "${1}"
}

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

breakpoint() {
  set -x
  bash --norc --noprofile
  set +x
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TEMPLATE_DIR="$SCRIPT_DIR/template"

############################################################
# Validation Functions
############################################################

function validate_project_name() {
  if [[ ! "$1" =~ ^[a-z][a-z0-9]+$ ]]; then
    echo "Error: Project name must start with a lowercase letter and contain only lowercase letters and numbers"
    exit 1
  fi
}

############################################################
# Main Script
############################################################

function apply_env() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/^APP_NAME=template/APP_NAME=${1}/g" .env
  else
    sed -i "s/^APP_NAME=template/APP_NAME=${1}/g" .env
  fi
}

function apply_database_yml() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/\${APP_NAME}/${1}/g" config/database.yml
  else
    sed -i "s/\${APP_NAME}/${1}/g" config/database.yml
  fi
}

function apply_core_settings() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/my-app/${1}/g" app/core/settings.py
  else
    sed -i "s/my-app/${1}/g" app/core/settings.py
  fi
}

function new_app() {
  if [ "$$1" == "" ]; then
    echo "Give a project name as the first argument"
    exit 1
  fi

  # Validate project name format
  validate_project_name "$1"

  mkdir $1
  cd $1

  # Initialize git repository
  git init
  git branch -M main

  # Use poetry for package management
  poetry init -n

  # Use virtualenv
  python -m venv venv
  source venv/bin/activate

  # Add common libraries
  poetry add \
    fastapi \
    uvicorn \
    alembic \
    dotenv \
    pydantic \
    pydantic-settings \
    sqlmodel \
    psycopg2 \
    celery \
    ipython

  # App structure
  mkdir -p \
    tests \
    config \
    public \
    app \
    db

  # Copy files
  cp $TEMPLATE_DIR/README.md README.md
  cp $TEMPLATE_DIR/public/robots.txt public/robots.txt
  cp $TEMPLATE_DIR/app/server.py app/server.py
  cp $TEMPLATE_DIR/app/console.py app/console.py
  cp $TEMPLATE_DIR/app/__init__.py app/__init__.py
  cp $TEMPLATE_DIR/gitignore .gitignore
  
  cp -r $TEMPLATE_DIR/app/api app/api
  cp -r $TEMPLATE_DIR/app/core app/
  cp -r $TEMPLATE_DIR/app/models app/
  cp -r $TEMPLATE_DIR/app/schemas app/
  cp -r $TEMPLATE_DIR/app/services app/
  cp -r $TEMPLATE_DIR/app/utils app/
  cp -r $TEMPLATE_DIR/app/jobs app/

  # Update env, config, core settings
  cp $TEMPLATE_DIR/.env .env
  apply_env $1

  cp $TEMPLATE_DIR/config/database.yml config/database.yml
  apply_database_yml $1

  cp $TEMPLATE_DIR/app/core/settings.py app/core/settings.py
  apply_core_settings $1

  # Use alembic for migrations
  alembic init db/migrations

  # Persist to repository
  git add .
  git commit -m "Initial commit"

  # Output project structure
  tree -L 2
}

############################################################
# Main Script
############################################################
if [[ $# -lt 1 ]] || [[ $1 == "--help" ]] || [[ $1 == "" ]]; then
  usage
  exit 2
elif [ -d "$1" ]; then
  echo "Project already exists"
  exit 1
else
  echo "Creating a Serp project with params: $@"
  new_app "$1"
fi
