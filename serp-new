#!/usr/bin/env bash

set -e

#~ USAGE
#~
#~   serp new NAME [OPTIONS]
#~
#~ DESCRIPTION
#~
#~   Creates a new Serp project, an opinionated AI-ready Python framework
#~   resembling Ruby on Rails.
#~
#~   Packages:
#~   - Poetry for dependency management
#~   - Console
#~   - Prisma for database interface
#~   - Redis
#~   - Background jobs with Celery (+Flower UI) backed by Redis or RabbitMQ
#~   - Preconfigured user and account models
#~   - Authentication
#~   - Docker with Make routines
#~   - Linter
#~   - Tests
#~   - Uvicorn webserver with http and websocket endpoints
#~   - File storage
#~   - Image processing with Image Magick
#~   - Document processing with Docling
#~   - Machine learning with Tensorflow, numpy, pandas, and other libraries
#~   - AI APIs with OpenAI, Anthropic, Gemini, and other LLM providers
#
#~   Still, you may resort to prisma studio for UI admin inferface (CRUD).
#~
#~ OPTIONS
#~
#~   --docling         - Add Docling library (adds ~800MB to the project)
#~
#~ COMMANDS
#~
#~   --help            - View these usage instructions
#~

log() {
  echo "${1}"
}

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

breakpoint() {
  set -x
  bash --norc --noprofile
  set +x
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TEMPLATE_DIR="$SCRIPT_DIR/template"

############################################################
# Validation Functions
############################################################

function validate_project_name() {
  if [[ ! "$project_name" =~ ^[a-z][a-z0-9]+$ ]]; then
    echo "Error: Project name must start with a lowercase letter and contain only lowercase letters and numbers"
    exit 1
  fi
}

############################################################
# Main Script
############################################################

# Libraries.
function add_docling() {
  poetry add "docling@^2.31.0" --python=">=3.13,<4.0" && \
    poetry lock
}

function install_optional_libraries() {
  unique_params=($(printf "%s\n" "${params[@]}" | sort -u))
  for param in "${unique_params[@]}"; do
    case "$param" in
      --docling)
        echo "Installing Docling library..."
        add_docling
        ;;
    esac
  done
}

# Environment.
function apply_env() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/^APP_NAME=template/APP_NAME=${1}/g" .env
    sed -i '' "s/^APP_NAME=template/APP_NAME=${1}/g" .env.test
  else
    sed -i "s/^APP_NAME=template/APP_NAME=${1}/g" .env
    sed -i "s/^APP_NAME=template/APP_NAME=${1}/g" .env.test
  fi
}

function apply_core_settings() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/my_app_development/${1}_development/g" config/initializers/settings.py
    sed -i '' "s/my_app_test/${1}_test/g" config/initializers/settings.py
  else
    sed -i "s/my_app_development/${1}_development/g" config/initializers/settings.py
    sed -i "s/my_app_test/${1}_test/g" config/initializers/settings.py
  fi
}

function apply_alembic_ini() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/sqlalchemy.url = driver:\/\/user:pass@localhost\/dbname/sqlalchemy.url = driver:\/\/postgres:postgres@localhost:5432\/${1}_development/g" alembic.ini
  else
    sed -i "s/sqlalchemy.url = driver:\/\/user:pass@localhost\/dbname/sqlalchemy.url = driver:\/\/postgres:postgres@localhost:5432\/${1}_development/g" alembic.ini
  fi
}

# Create a new app.
function new_app() {
  if [ "$1" == "" ]; then
    echo "Give a project name as the first argument"
    exit 1
  fi

  # Store project name
  local project_name="$1"
  shift

  # Validate project name format
  validate_project_name "$project_name"

  mkdir $project_name
  cd $project_name

  # Initialize git repository
  git init > /dev/null
  git branch -M main

  # Use poetry for package management
  poetry init -n

  # Use virtualenv
  python -m venv venv
  source venv/bin/activate

  # Add common libraries
  poetry add \
    "ipython" \
    "pylint" \
    "fastapi@<1" \
    "uvicorn@<1" \
    "alembic@<2" \
    "python-dotenv" \
    "pydantic@<3" \
    "pydantic-settings@<3" \
    "sqlmodel@<1" \
    "psycopg2@<3" \
    "celery@<6" \
    "redis@<7" \
    "flower@<3" \
    "pytest@<9" \
    "Wand@<1" \
    "PyJWT@<3"

  install_optional_libraries "${params[@]}"

  poetry install --no-root

  # App structure
  mkdir -p \
    tests \
    config \
    public \
    bin \
    app \
    db \
    lib/{core,tasks} \
    tmp

  # Copy files
  cp $TEMPLATE_DIR/README.md README.md
  cp $TEMPLATE_DIR/Makefile Makefile
  cp $TEMPLATE_DIR/public/robots.txt public/robots.txt
  cp $TEMPLATE_DIR/app/server.py app/server.py
  cp $TEMPLATE_DIR/app/console.py app/console.py
  cp $TEMPLATE_DIR/app/__init__.py app/__init__.py
  cp $TEMPLATE_DIR/gitignore .gitignore
  cp $TEMPLATE_DIR/bash_aliases .bash_aliases
  cp $TEMPLATE_DIR/bin/* bin/

  cp -r $TEMPLATE_DIR/app/api app/
  cp -r $TEMPLATE_DIR/app/models app/
  cp -r $TEMPLATE_DIR/app/schemas app/
  cp -r $TEMPLATE_DIR/app/services app/
  cp -r $TEMPLATE_DIR/app/utils app/
  cp -r $TEMPLATE_DIR/app/jobs app/
  cp -r $TEMPLATE_DIR/config/* config/
  cp -r $TEMPLATE_DIR/tests/* tests/
  cp -r $TEMPLATE_DIR/lib/core/* lib/core/
  cp -r $TEMPLATE_DIR/lib/tasks/* lib/tasks/
  cp -r $TEMPLATE_DIR/db/* db/

  # Update env, config, core settings
  cp $TEMPLATE_DIR/.env .env
  cp $TEMPLATE_DIR/.env.test .env.test
  apply_env $project_name
  apply_core_settings $project_name

  # Use alembic for migrations
  alembic init db/migrations > /dev/null
  apply_alembic_ini $project_name

  # Persist to repository
  git add .
  git commit -m "Initial commit" > /dev/null

  # Output project structure
  tree -a -I venv -I .git -I .env -I .env.test
}

############################################################
# Main Script
############################################################
if [[ $# -lt 1 ]] || [[ $1 == "--help" ]] || [[ $1 == "-h" ]] || [[ $1 == "help" ]] || [[ $1 == "" ]]; then
  usage
  exit 1
elif [ -d "$1" ]; then
  echo "Project already exists"
  exit 2
fi

project_name="$1"
shift
params=("$@")
echo "Creating Serp project \`$project_name\` with params \`${params[@]}\`"
new_app "$project_name" "${params[@]}"
