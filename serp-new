#!/usr/bin/env bash

set -e

#~ USAGE
#~
#~   serp new NAME [OPTIONS]
#~
#~ DESCRIPTION
#~
#~   Creates a new Serp project, an opinionated AI-ready Python framework
#~   resembling Ruby on Rails.
#~
#~   Packages:
#~   - Poetry for dependency management
#~   - Console
#~   - Prisma for database interface
#~   - Redis
#~   - Background jobs with Celery (+Flower UI) backed by Redis or RabbitMQ
#~   - Preconfigured user and account models
#~   - Authentication
#~   - Docker with Make routines
#~   - Linter
#~   - Tests
#~   - Uvicorn webserver with http and websocket endpoints
#~   - File storage
#~   - Image processing with Image Magick
#~   - Document processing with Docling
#~   - Machine learning with Tensorflow, numpy, pandas, and other libraries
#~   - AI APIs with OpenAI, Anthropic, Gemini, and other LLM providers
#
#~   Still, you may resort to prisma studio for UI admin inferface (CRUD).
#~
#~ OPTIONS
#~
#~ Modules:
#~   --with-docling         - Add Docling library (adds ~800MB to the project)
#~   --with-ai              - Add AI libraries OpenAI, Anthropic, Google
#~                            Generative AI, LangChain, HuggingFace
#~   --with-geoip           - Add GeoIP to get users location
#~
#~ Commands:
#~   --quiet                - Suppress output
#~   --help                 - View these usage instructions
#~

log() {
  echo "${1}"
}

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

debug() {
  set -x
  bash --norc --noprofile
  set +x
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

############################################################
# Validation Functions
############################################################

function validate_project_name() {
  if [[ ! "$project_name" =~ ^[a-z][a-z0-9]+$ ]]; then
    echo "Error: Project name must start with a lowercase letter and contain only lowercase letters and numbers"
    exit 1
  fi
}

############################################################
# Main Script
############################################################

makequiet() {
    if [ "$1" != "true" ] && [ "$1" != "false" ]; then
        echo "Error: First argument must be 'true' or 'false'"
        return 1
    fi
    
    local should_quiet="$1"
    shift  # Remove the quiet boolean from arguments
    
    if [ "$should_quiet" == "true" ]; then
        "$@" > /dev/null
    else
        "$@"
    fi
}

post_install_message() {
  GREEN="\033[32m"
  RED="\033[31m"
  RESET="\033[0m"
  echo -e "Activate ${RED}venv${RESET} to use the project with ${GREEN}\`source venv/bin/activate\`.${RESET}"
}

# Libraries.
function add_docling() {
  poetry add "docling@^2.31.0" --python=">=3.13,<4.0" && \
    poetry lock
}

function add_ai() {
  poetry add \
    "openai" \
    "anthropic" \
    "google-generativeai" \
    "huggingface-hub"
  poetry add "langchain" "langchain-community" --python=">=3.13,<4.0"
  poetry lock
}

function add_geoip() {
  poetry add "geoip2" "user-agents"
  poetry lock
  mkdir -p lib/core/geo
  curl -L -A "Mozilla/5.0" https://github.com/P3TERX/GeoLite.mmdb/raw/main/GeoLite2-City.mmdb -o lib/core/geo/GeoLite2-City.mmdb
  if [ ! -e lib/core/geo/GeoLite2-City.mmdb ]; then
    echo "Can't download GeoLite2-City.mmdb from https://github.com/P3TERX/GeoLite.mmdb"
    echo "Go to https://github.com/P3TERX/GeoLite.mmdb and download it manually"
    echo "and put it in lib/core/geo/"
    exit 1
  fi
}

function install_optional_libraries() {
  unique_params=($(printf "%s\n" "${params[@]}" | sort -u))
  for param in "${unique_params[@]}"; do
    case "$param" in
      --with-docling)
        echo "Installing Docling library..."
        add_docling
        ;;
      --with-ai)
        echo "Installing AI libraries OpenAI, Anthropic, Google Generative AI, LangChain, HuggingFace, LangChain Community..."
        add_ai
        ;;
      --with-geoip)
        echo "Installing GeoIP libraries..."
        add_geoip
        ;;
    esac
  done
}

# Environment.
function apply_env() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/^APP_NAME=template/APP_NAME=${1}/g" .env.*
    sed -i '' "s/serp_app_development$/${1}_development/g" .env.development
    sed -i '' "s/serp_app_production$/${1}_production/g" .env.production
    sed -i '' "s/serp_app_test$/${1}_test/g" .env.test
  else
    sed -i "s/^APP_NAME=template/APP_NAME=${1}/g" .env.*
    sed -i "s/serp_app_development$/${1}_development/g" .env.development
    sed -i "s/serp_app_production$/${1}_production/g" .env.production
    sed -i "s/serp_app_test$/${1}_test/g" .env.test
  fi
}

function apply_core_settings() {
  return 0
  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s/serp_app/${1}/g" config/core/settings.py
  else
    sed -i "s/serp_app/${1}/g" config/core/settings.py
  fi
}

# Create a new app.
function new_app() {
  if [ "$1" == "" ]; then
    echo "Give a project name as the first argument"
    exit 1
  fi

  # Get project parameters
  quiet=$([[ " ${params[@]} " =~ " --quiet " || " ${params[@]} " =~ " --silent " ]] && echo "true" || echo "false")

  # Store project name
  local project_name="$1"
  shift

  # Validate project name format
  validate_project_name "$project_name"

  mkdir $project_name
  cd $project_name

  # Initialize git repository
  git init > /dev/null
  git branch -M main

  # Fetch template
  git remote add template https://github.com/cassiopagnoncelli/serp-template.git
  serp update

  # Use virtualenv
  # start a new one with python3 -m venv venv.
  python3 -m venv venv
  source venv/bin/activate

  # Install dependencies from pyproject.toml and poetry.lock
  makequiet $quiet poetry install --no-root
  makequiet $quiet poetry env activate

  # Install optional libraries.
  makequiet $quiet install_optional_libraries "${params[@]}"

  # Update env, config, core settings
  apply_env $project_name
  apply_core_settings $project_name

  # Use alembic for migrations (alembic init db/migrations)
  # Setup the database with dbcreate and dbload
  makequiet $quiet serp dbcreate
  makequiet $quiet serp dbload
  makequiet $quiet serp seed

  # Create test database
  APP_ENV=test makequiet $quiet serp dbcreate

  # Persist to repository
  git add .
  git commit -m "Setting up project settings" > /dev/null

  # Output project structure
  makequiet $quiet tree -a -I venv -I .git

  # Post install message
  makequiet $quiet post_install_message
}

############################################################
# Main Script
############################################################
if [[ $# -lt 1 ]] || [[ $1 == "--help" ]] || [[ $1 == "-h" ]] || [[ $1 == "help" ]] || [[ $1 == "" ]]; then
  usage
  exit 1
elif [ -d "$1" ]; then
  echo "Project already exists"
  exit 2
fi

project_name="$1"
shift
params=("$@")

GREEN="\033[32m"
RED="\033[31m"
RESET="\033[0m"
if [ "${#params[@]}" -gt 0 ]; then
  echo -e "Creating Serp project ${GREEN}${project_name}${RESET} with params ${GREEN}${params[@]}${RESET}"
else
  echo -e "Creating Serp project ${GREEN}${project_name}${RESET} with no params"
fi

new_app "$project_name" "${params[@]}"
