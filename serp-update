#!/usr/bin/env bash

set -e

#~ USAGE
#~
#~   serp update
#~
#~
#~ COMMANDS
#~
#~   --help  - View these usage instructions
#~

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_ROOT=$(command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git rev-parse --show-toplevel || ([ -d /app ] && echo /app || pwd))

############################################################
# Main Script
############################################################

function run_update() {
  # Fetch bin update
  git submodule update --init --recursive
  cd lib/bin && git pull origin main && cd ../..

  # Fetch template update
  git fetch template
  
  # Check if there are uncommitted changes
  if ! git diff-index --quiet HEAD --; then
    echo "Warning: You have uncommitted changes. Please commit or stash them before updating."
    echo "Uncommitted changes:"
    git status --porcelain
    exit 1
  fi
  
  # Rebase current branch onto template/main instead of overwriting
  echo "Rebasing current branch onto template/main..."
  git rebase template/main
  
  if [ $? -eq 0 ]; then
    echo "✅ Successfully rebased onto template updates"
    git log --oneline -10
  else
    echo "❌ Rebase conflicts detected. Please resolve conflicts and run:"
    echo "   git rebase --continue"
    echo "Or abort the rebase with:"
    echo "   git rebase --abort"
    exit 1
  fi
}

run_update
