#!/usr/bin/env bash

set -e

#~ USAGE
#~ 
#~   serp COMMAND
#~
#~
#~ COMMANDS
#~
#~   new           - Set up a new serp project
#~
#~   c, console    - Open app console
#~   db            - Open database console
#~   s, server     - Run the serp server
#~   w, worker     - Run the serp worker
#~
#~   t, test       - Run the tests
#~   l, lint       - Run the linter
#~
#~   db:migrate    - Run the migrations
#~   db:rollback   - Rollback the migrations
#~   db:seed       - Fills an empy local dev pgsql database with seed data.
#~   db:reset      - Wipes the dev pgsql database, recreates it clean from
#~                   migrations, and seeds it with seed data. Useful for clean
#~                   dev environment setup and for switching customer
#~                   enviromnets in local development.
#~
#~   redis         - Open CLI access to the Redis instance
#~   redis:monitor - Run Redis monitor (https://redis.io/commands/monitor/)
#~
#~   help          - View these usage instructions
#~

log() {
  echo "${1}"
}

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TEMPLATE_DIR="$SCRIPT_DIR/templates"

############################################################
# Main Script
############################################################
if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

while [[ $# -gt 0 ]]; do
  command="$1"
  shift 1
  params=("$@")
  case "$command" in
    new)
      "$SCRIPT_DIR/serp-new" "${params}"
      ;;

    --help|help)
      usage | ${PAGER}
      break
      ;;
    *)
      log "Unknown command: $command"
      break
      ;;
  esac
done
