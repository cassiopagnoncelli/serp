#!/usr/bin/env bash

set -e

#~ USAGE
#~ 
#~   serp COMMAND
#~
#~
#~ COMMANDS
#~
#~    new           - Set up a new serp project
#~
#~  Processes
#~    console, c    - Open app console
#~    db            - Open Postgres console
#~    redis         - Open Redis console
#~    dev, s        - Run web server in development mode
#~    prod          - Run web server in production mode
#~    worker, w     - Run celery worker
#~
#~  Database commands
#~    dbcreate      - Create the database
#~    dbdrop        - Drop the database
#~    [x]dbload     - Load schema up from migrations
#~    [x]dbsetup    - Setup the database
#~    seed          - Fills an empy local dev pgsql database with seed data
#~
#~  Monitoring
#~    redismon      - Run Redis monitor (https://redis.io/commands/monitor/)
#~    flower        - Run Flower (Celery's monitor UI)
#~
#~  Routines
#~    env           - Show the current environment (APP_ENV env variable)
#~    secret        - Generate a secure random secret
#~
#~  Tasks
#~    tasks         - List available tasks
#~    task          - Run task
#~
#~  Generators
#~    frontend, fe  - Generate the frontend project (nextjs app in a sibiling directory)
#~
#~  Code quality
#~    test, t       - Run the tests
#~    lint          - Run the linter
#~    dev-deps      - Install development dependencies
#~
#~  Help
#~    help          - View these usage instructions
#~

log() {
  echo "${1}"
}

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TEMPLATE_DIR="$SCRIPT_DIR/templates"

############################################################
# Main Script
############################################################
if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

command="$1"
shift 1
params=("$@")
case "$command" in
  new)
    "$SCRIPT_DIR/serp-new" "${params[@]}"
    exit 0
    ;;

  # Processes.
  c|console)
    "$SCRIPT_DIR/serp-console" "${params[@]}"
    exit 0
    ;;

  db)
    "$SCRIPT_DIR/serp-db" "${params[@]}"
    exit 0
    ;;

  redis)
    "$SCRIPT_DIR/serp-redis-cli" "${params[@]}"
    exit 0
    ;;

  s|dev)
    "$SCRIPT_DIR/serp-dev" "${params[@]}"
    exit 0
    ;;

  p|prod)
    "$SCRIPT_DIR/serp-prod" "${params[@]}"
    exit 0
    ;;

  w|worker)
    "$SCRIPT_DIR/serp-worker" "${params[@]}"
    exit 0
    ;;

  # Database commands.
  dbcreate)
    "$SCRIPT_DIR/serp-dbcreate" "${params[@]}"
    exit 0
    ;;

  dbdrop)
    "$SCRIPT_DIR/serp-dbdrop" "${params[@]}"
    exit 0
    ;;

  dbload)
    "$SCRIPT_DIR/serp-dbload" "${params[@]}"
    exit 0
    ;;

  dbsetup)
    "$SCRIPT_DIR/serp-dbsetup" "${params[@]}"
    exit 0
    ;;

  seed)
    "$SCRIPT_DIR/serp-seed" "${params[@]}"
    exit 0
    ;;

  # Monitoring
  redismon)
    "$SCRIPT_DIR/serp-redis-monitor" "${params[@]}"
    exit 0
    ;;

  flower)
    "$SCRIPT_DIR/serp-flower" "${params[@]}"
    exit 0
    ;;

  # Routines.
  env)
    "$SCRIPT_DIR/serp-env" "${params[@]}"
    exit 0
    ;;

  secret)
    "$SCRIPT_DIR/serp-secret" "${params[@]}"
    exit 0
    ;;

  # Tasks.
  tasks)
    "$SCRIPT_DIR/serp-tasks" "${params[@]}"
    exit 0
    ;;

  task)
    "$SCRIPT_DIR/serp-task" "${params[@]}"
    exit 0
    ;;

  # Generators.
  frontend|fe)
    "$SCRIPT_DIR/serp-frontend" "${params[@]}"
    exit 0
    ;;

  # Code quality.
  t|test)
    "$SCRIPT_DIR/serp-test" "${params[@]}"
    exit 0
    ;;

  l|lint)
    "$SCRIPT_DIR/serp-lint" "${params[@]}"
    exit 0
    ;;

  # Help.
  --help|help)
    usage | ${PAGER:-less}
    exit 0
    ;;

  *)
    log "Unknown command: ${command}"
    usage
    exit 0
    ;;
esac
