#!/usr/bin/env bash

set -e

#~ USAGE
#~
#~   serp db
#~
#~
#~ COMMANDS
#~
#~   --help  - View these usage instructions
#~

log() {
  echo "${1}"
}

usage() {
  grep '^#~' < "$0" | cut -c 3-
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
TEMPLATE_DIR="$SCRIPT_DIR/template"
PROJECT_ROOT=$(git rev-parse --show-toplevel)

############################################################
# Main Script
############################################################

function run_db_console() {
  CONN_STRING=$(PYTHONPATH="$PROJECT_ROOT" poetry run python lib/core/database/url.py)
  if [ -z "$CONN_STRING" ]; then
    echo "No connection string found"
    exit 1
  elif [[ "$CONN_STRING" == *"sqlite"* ]]; then
    DB_PATH="${CONN_STRING#sqlite:///}"
    DB_PATH="${DB_PATH#sqlite://}"
    echo "Opening SQLite database: $DB_PATH"
    sqlite3 "$DB_PATH"
  elif [[ "$CONN_STRING" == *"postgres"* ]]; then
    psql "$CONN_STRING"
  else
    echo "Unsupported database type"
    exit 1
  fi
}

run_db_console
